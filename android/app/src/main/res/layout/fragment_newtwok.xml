<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="#F2F2F2"
    tools:context=".ui.newTwok.NewTwokFragment">

    <LinearLayout
        android:id="@+id/twokInputTextPage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:elevation="1dp"
        android:background="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close"
                style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/close_foreground"
                app:strokeWidth="0dp"
                tools:layout_editor_absoluteX="271dp"
                tools:layout_editor_absoluteY="158dp" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ok"
                style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ok_foreground"
                app:strokeWidth="0dp"
                tools:layout_editor_absoluteX="271dp"
                tools:layout_editor_absoluteY="158dp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/twokInputText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:textAlignment="center" >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/twokTextModified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:background="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/bottongroupjustify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.488"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0">

                <Button
                    android:id="@+id/fontfamilyButton"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="60dp"
                    android:layout_height="68dp"
                    android:text="Aa"
                    android:textSize="24dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="@null"
                    app:toggleCheckedStateOnClick="false"
                    tools:layout_editor_absoluteX="5dp"
                    tools:layout_editor_absoluteY="158dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/halignButton"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/alignleft_foreground"
                    app:strokeWidth="0dp"
                    app:rippleColor="@null"
                    app:toggleCheckedStateOnClick="false"
                    tools:layout_editor_absoluteX="271dp"
                    tools:layout_editor_absoluteY="158dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/valignButton"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/justifytop_foreground"
                    app:strokeWidth="0dp"
                    app:rippleColor="@null"
                    app:toggleCheckedStateOnClick="false"
                    tools:layout_editor_absoluteX="137dp"
                    tools:layout_editor_absoluteY="158dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backgroundcolorButton"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/backgroundcolor_foreground"
                    app:strokeWidth="0dp"
                    app:rippleColor="@null"
                    app:toggleCheckedStateOnClick="false"
                    tools:layout_editor_absoluteX="137dp"
                    tools:layout_editor_absoluteY="158dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fontcolorButton"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/fontcol_foreground"
                    app:strokeWidth="0dp"
                    app:rippleColor="@null"
                    app:toggleCheckedStateOnClick="false"
                    tools:layout_editor_absoluteX="5dp"
                    tools:layout_editor_absoluteY="158dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/posizioneButton"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/positionoff_foreground"
                    app:strokeWidth="0dp"
                    app:rippleColor="@null"
                    app:toggleCheckedStateOnClick="false"
                    tools:layout_editor_absoluteX="5dp"
                    tools:layout_editor_absoluteY="158dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>


            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:max="40"
                android:min="20"
                android:progress="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/twok"
            android:text="Provaaaa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:background="@color/white"
            android:padding="20dp"
            android:typeface="monospace"
            android:layout_marginBottom="@android:dimen/app_icon_size"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

